@startuml
skinparam dpi 160
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #7A5C43
skinparam ArrowFontSize 12
skinparam actorStyle awesome
skinparam actor {
  BorderColor #7A5C43
  BackgroundColor #F3E7D8
}
skinparam usecase {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
  FontSize 13
}
skinparam rectangle {
  BorderColor #A98867
  BackgroundColor #FFFDF9
}
skinparam component {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
}
skinparam database {
  BorderColor #7A5C43
  BackgroundColor #F3E7D8
}
skinparam queue {
  BorderColor #7A5C43
  BackgroundColor #F3E7D8
}
skinparam cloud {
  BorderColor #A98867
  BackgroundColor #FFFDF9
}
skinparam participant {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
}
skinparam sequence {
  LifeLineBorderColor #A98867
  LifeLineBackgroundColor #F3E7D8
  ArrowColor #7A5C43
  DividerBackgroundColor #EFE2D0
  BoxBackgroundColor #FAF5EE
  BoxBorderColor #C9B197
  GroupBackgroundColor #EFE2D0
  GroupBorderColor #A98867
}
skinparam note {
  BorderColor #C9A227
  BackgroundColor #FFF9E8
}
skinparam class {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
  HeaderBackgroundColor #E8D7C3
}
title Biểu đồ phân rã use case Hỗ trợ khách hàng
left to right direction
actor Guest as G
actor "Member" as M
actor "Trợ lý ảo AI" as BOT
actor "Nhân viên trực\n(Editor / Admin)" as NV

rectangle "Hỗ trợ khách hàng" {
  usecase "Đặt câu hỏi\ncho trợ lý ảo" as U1
  usecase "Gọi công cụ\ntìm kiếm sản phẩm" as U2
  usecase "Gọi công cụ\ntra cứu đơn hàng" as U3
  usecase "Yêu cầu gặp\nnhân viên" as U4
  usecase "Xem hàng đợi\nhội thoại" as U5
  usecase "Nhận phiên\nhội thoại" as U6
  usecase "Trao đổi tin nhắn\nthời gian thực" as U7
  usecase "Đánh dấu đã đọc" as U8
  usecase "Đóng phiên\nhội thoại" as U9
  usecase "Gửi email fallback\nngoài giờ trực" as U10
}

G --> U1
M --> U1
G --> U4
M --> U4
NV --> U5
NV --> U6
NV --> U7
NV --> U8
NV --> U9

U1 <-- BOT
U1 ..> U2 : <<extend>>
U1 ..> U3 : <<extend>>
U4 ..> U10 : <<extend>>
U6 ..> U7 : <<include>>
@enduml
