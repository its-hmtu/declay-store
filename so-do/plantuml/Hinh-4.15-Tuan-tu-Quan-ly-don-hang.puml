@startuml
skinparam dpi 160
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #7A5C43
skinparam ArrowFontSize 12
skinparam actorStyle awesome
skinparam actor {
  BorderColor #7A5C43
  BackgroundColor #F3E7D8
}
skinparam usecase {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
  FontSize 13
}
skinparam rectangle {
  BorderColor #A98867
  BackgroundColor #FFFDF9
}
skinparam component {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
}
skinparam database {
  BorderColor #7A5C43
  BackgroundColor #F3E7D8
}
skinparam queue {
  BorderColor #7A5C43
  BackgroundColor #F3E7D8
}
skinparam cloud {
  BorderColor #A98867
  BackgroundColor #FFFDF9
}
skinparam participant {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
}
skinparam sequence {
  LifeLineBorderColor #A98867
  LifeLineBackgroundColor #F3E7D8
  ArrowColor #7A5C43
  DividerBackgroundColor #EFE2D0
  BoxBackgroundColor #FAF5EE
  BoxBorderColor #C9B197
  GroupBackgroundColor #EFE2D0
  GroupBorderColor #A98867
}
skinparam note {
  BorderColor #C9A227
  BackgroundColor #FFF9E8
}
skinparam class {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
  HeaderBackgroundColor #E8D7C3
}
autonumber

title Biểu đồ tuần tự chức năng Quản lý đơn hàng

actor "Quản trị viên" as A
participant "Giao diện Admin" as FE
participant "OrderService" as OS
database "PostgreSQL" as DB
queue "emailQueue" as Q
participant "auditAdminWrites" as AU
participant "GhnService" as GS

A -> FE : Mở màn hình quản lý đơn hàng
FE -> OS : GET /api/admin/orders?status=&page=
OS -> DB : SELECT orders + items + shipment
OS --> FE : Danh sách đơn hàng

A -> FE : Chọn trạng thái mới cho đơn
FE -> OS : PUT /api/admin/orders/:id/status
OS -> OS : statusTransitionError(current, next)
alt Chuyển trạng thái không hợp lệ
  OS --> FE : AppError 400 "Không thể lùi trạng thái"
else Hợp lệ
  OS -> DB : UPDATE orders SET status, mốc thời gian
  OS -> Q : Đẩy email thông báo trạng thái
  OS --> AU : Kết quả
  AU -> DB : INSERT audit_log
  AU --> FE : sendSuccess(200)
end

A -> FE : Tạo vận đơn GHN
FE -> GS : POST /api/admin/orders/:id/shipment/ghn
GS -> GS : Gọi API tạo vận đơn
GS -> DB : INSERT order_shipments (mã vận đơn, chi phí, nhãn)
GS --> FE : Thông tin vận đơn
FE --> A : Hiển thị mã vận đơn và nhãn in
@enduml
