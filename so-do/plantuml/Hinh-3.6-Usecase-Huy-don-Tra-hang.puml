@startuml
skinparam dpi 160
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #7A5C43
skinparam ArrowFontSize 12
skinparam actorStyle awesome
skinparam actor {
  BorderColor #7A5C43
  BackgroundColor #F3E7D8
}
skinparam usecase {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
  FontSize 13
}
skinparam rectangle {
  BorderColor #A98867
  BackgroundColor #FFFDF9
}
skinparam component {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
}
skinparam database {
  BorderColor #7A5C43
  BackgroundColor #F3E7D8
}
skinparam queue {
  BorderColor #7A5C43
  BackgroundColor #F3E7D8
}
skinparam cloud {
  BorderColor #A98867
  BackgroundColor #FFFDF9
}
skinparam participant {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
}
skinparam sequence {
  LifeLineBorderColor #A98867
  LifeLineBackgroundColor #F3E7D8
  ArrowColor #7A5C43
  DividerBackgroundColor #EFE2D0
  BoxBackgroundColor #FAF5EE
  BoxBorderColor #C9B197
  GroupBackgroundColor #EFE2D0
  GroupBorderColor #A98867
}
skinparam note {
  BorderColor #C9A227
  BackgroundColor #FFF9E8
}
skinparam class {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
  HeaderBackgroundColor #E8D7C3
}
title Biểu đồ phân rã use case Hủy đơn và trả hàng
left to right direction
actor "Member" as M
actor Admin as A

rectangle "Hủy đơn hàng" {
  usecase "Yêu cầu hủy đơn" as C1
  usecase "Kiểm tra điều kiện hủy\n(trạng thái đơn)" as C2
  usecase "Hủy ngay\n(chưa có vận đơn)" as C3
  usecase "Tạo yêu cầu hủy\nchờ duyệt" as C4
  usecase "Hủy vận đơn GHN" as C5
  usecase "Hoàn trả tồn kho" as C6
}

rectangle "Trả hàng và hoàn tiền" {
  usecase "Yêu cầu trả hàng" as R1
  usecase "Kiểm tra thời hạn\n7 ngày" as R2
  usecase "Chọn món và\nsố lượng trả" as R3
  usecase "Tải ảnh\nchứng minh" as R4
  usecase "Duyệt yêu cầu\ntrả hàng" as R5
  usecase "Xác nhận\nnhận hàng trả" as R6
  usecase "Tính số tiền hoàn" as R7
}

usecase "Khởi tạo\nhoàn tiền" as RF

M --> C1
M --> R1
A --> C4
A --> R5
A --> R6

C1 ..> C2 : <<include>>
C2 <|-- C3
C2 <|-- C4
C4 ..> C5 : <<include>>
C3 ..> C6 : <<include>>
C4 ..> C6 : <<include>>
C3 ..> RF : <<extend>>

R1 ..> R2 : <<include>>
R1 ..> R3 : <<include>>
R3 ..> R4 : <<include>>
R5 ..> R6 : <<include>>
R6 ..> R7 : <<include>>
R7 ..> RF : <<include>>
@enduml
