}
autonumber

title Biểu đồ tuần tự chức năng Tìm kiếm sản phẩm

actor "Người dùng" as U
participant "Giao diện" as FE
participant "validate" as VAL
participant "cacheMiddleware" as CM
database "Redis" as RD
participant "ProductService" as S
database "PostgreSQL" as DB

U -> FE : Nhập từ khóa và chọn bộ lọc
FE -> VAL : GET /api/products?search=&categoryId=&minPrice=
VAL -> VAL : Kiểm tra tham số truy vấn
VAL -> CM : next()
CM -> RD : GET khóa cache
alt Có trong cache
  RD --> CM : Kết quả đã lưu
  CM --> FE : sendSuccess(dữ liệu từ cache)
else Không có trong cache
  CM -> S : list(filters)
  S -> DB : SELECT products JOIN variants ... LIMIT/OFFSET
  DB --> S : Danh sách sản phẩm
  S -> S : Tính giá hiệu lực (specialPrice, campaign)
  S --> CM : Kết quả + meta phân trang
  CM -> RD : SET khóa cache (TTL)
  CM --> FE : sendSuccess(dữ liệu)
end
FE --> U : Hiển thị lưới sản phẩm + phân trang
@enduml
