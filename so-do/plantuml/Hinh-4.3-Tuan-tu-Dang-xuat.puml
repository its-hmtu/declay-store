  BackgroundColor #FFF9E8
}
skinparam class {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
  HeaderBackgroundColor #E8D7C3
}
autonumber

title Biểu đồ tuần tự chức năng Đăng xuất

actor "Người dùng" as U
participant "Giao diện" as FE
participant "authMiddleware" as MW
participant "AuthController" as C
participant "AuthService" as S
database "Redis" as RD

U -> FE : Chọn chức năng Đăng xuất
FE -> MW : POST /api/auth/logout (Bearer token)
MW -> MW : Xác thực JWT, gắn req.user
MW -> C : next()
C -> S : logout(jti)
S -> RD : Ghi jti vào danh sách chặn
RD --> S : OK
S --> C : Thành công
C --> FE : sendSuccess(200)
FE -> FE : Xóa token khỏi bộ nhớ
FE --> U : Chuyển về trang chủ
@enduml
