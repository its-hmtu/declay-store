}
autonumber

title Biểu đồ tuần tự chức năng Xác nhận thanh toán qua webhook

participant "Stripe / VNPay" as PAY
participant "WebhookController" as WC
database "PostgreSQL" as DB
participant "OrderService" as OS
participant "PaymentService" as PS
participant "CartService" as CS
queue "emailQueue" as Q
participant "NotificationService" as NS

PAY -> WC : POST /api/webhooks/stripe (raw body)
WC -> WC : Xác thực chữ ký bằng khóa bí mật
alt Chữ ký không hợp lệ
  WC --> PAY : 400 Bad Request
else Chữ ký hợp lệ
  WC -> DB : SELECT processed_webhook_events
  alt Sự kiện đã xử lý
    WC --> PAY : 200 OK (bỏ qua)
  else Sự kiện mới
    WC -> OS : markPaid(paymentIntentId)
    group Giao dịch có khóa dòng
      OS -> DB : SELECT orders ... FOR UPDATE
      OS -> DB : UPDATE orders SET status='paid', paid_at=NOW()
    end
    OS -> PS : Ghi nhận giao dịch
    PS -> DB : INSERT payments (status='succeeded')
    OS -> CS : Xóa giỏ hàng của khách
    OS -> Q : Đẩy email xác nhận đơn hàng
    OS -> DB : Kiểm tra tồn kho thấp
    OS -> NS : notifyAdmins("low_stock")
    WC -> DB : INSERT processed_webhook_events
    WC --> PAY : 200 OK
  end
end
@enduml
