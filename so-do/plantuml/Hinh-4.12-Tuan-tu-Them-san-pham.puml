  HeaderBackgroundColor #E8D7C3
}
autonumber

title Biểu đồ tuần tự chức năng Thêm mới sản phẩm

actor "Quản trị viên" as A
participant "Giao diện Admin" as FE
participant "adminProtect" as AP
participant "requireRole" as RR
participant "validate" as VAL
participant "ProductService" as S
database "PostgreSQL" as DB
participant "auditAdminWrites" as AU
database "Redis" as RD

A -> FE : Nhập thông tin sản phẩm và nhấn Lưu
FE -> AP : POST /api/admin/products
AP -> AP : Xác thực JWT quản trị (khóa riêng)
AP -> RR : next()
RR -> RR : Kiểm tra vai trò admin / super_admin
alt Không đủ quyền
  RR --> FE : 403 Forbidden
else Đủ quyền
  RR -> VAL : next()
  VAL -> S : create(data)
  S -> DB : SELECT products WHERE slug = ?
  alt Slug đã tồn tại
    S --> FE : AppError 400 "Slug bị trùng"
  else Slug hợp lệ
    S -> DB : INSERT products
    S -> DB : INSERT product_tags
    S -> RD : Xóa khóa cache danh sách sản phẩm
    S --> AU : Kết quả
    AU -> DB : INSERT audit_log
    AU --> FE : sendSuccess(201)
    FE --> A : Chuyển sang tab quản lý phiên bản
  end
end
@enduml
