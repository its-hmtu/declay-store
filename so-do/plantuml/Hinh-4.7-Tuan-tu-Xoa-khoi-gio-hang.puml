autonumber

title Biểu đồ tuần tự chức năng Xóa sản phẩm khỏi giỏ hàng

actor "Người dùng" as U
participant "Giao diện" as FE
participant "CartController" as C
participant "CartService" as S
database "PostgreSQL" as DB

U -> FE : Nhấn biểu tượng xóa trên dòng hàng
FE -> C : DELETE /api/cart/items/:itemId
C -> S : removeItem(owner, itemId)
S -> DB : SELECT cart_items JOIN carts
DB --> S : Dòng hàng
alt Dòng không thuộc giỏ của người dùng
  S --> C : AppError 404
  C --> FE : Không tìm thấy dòng hàng
else Hợp lệ
  S -> DB : DELETE FROM cart_items WHERE id = ?
  S -> DB : SELECT lại giỏ hàng
  S -> S : Tính lại tổng tiền tạm tính
  S --> C : Giỏ hàng đã cập nhật
  C --> FE : sendSuccess(200)
  FE --> U : Cập nhật danh sách và tổng tiền
end
@enduml
