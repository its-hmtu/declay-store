@startuml
skinparam dpi 160
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #7A5C43
skinparam ArrowFontSize 12
skinparam actorStyle awesome
skinparam actor {
  BorderColor #7A5C43
  BackgroundColor #F3E7D8
}
skinparam usecase {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
  FontSize 13
}
skinparam rectangle {
  BorderColor #A98867
  BackgroundColor #FFFDF9
}
skinparam component {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
}
skinparam database {
  BorderColor #7A5C43
  BackgroundColor #F3E7D8
}
skinparam queue {
  BorderColor #7A5C43
  BackgroundColor #F3E7D8
}
skinparam cloud {
  BorderColor #A98867
  BackgroundColor #FFFDF9
}
skinparam participant {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
}
skinparam sequence {
  LifeLineBorderColor #A98867
  LifeLineBackgroundColor #F3E7D8
  ArrowColor #7A5C43
  DividerBackgroundColor #EFE2D0
  BoxBackgroundColor #FAF5EE
  BoxBorderColor #C9B197
  GroupBackgroundColor #EFE2D0
  GroupBorderColor #A98867
}
skinparam note {
  BorderColor #C9A227
  BackgroundColor #FFF9E8
}
skinparam class {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
  HeaderBackgroundColor #E8D7C3
}
title Biểu đồ phân rã use case Đặt hàng và thanh toán
left to right direction
actor Guest as G
actor "Member" as M
actor "Hệ thống\nvận chuyển" as SHIP
actor "Hệ thống\nthanh toán" as PAY

rectangle "Đặt hàng và thanh toán" {
  usecase "Chọn / nhập\nđịa chỉ giao hàng" as U1
  usecase "Tra cứu địa giới\nhành chính" as U2
  usecase "Báo giá phí\nvận chuyển" as U3
  usecase "Áp dụng mã\ngiảm giá" as U4
  usecase "Chọn phương thức\nthanh toán" as U5
  usecase "Tạo đơn hàng và\ngiữ tồn kho" as U6
  usecase "Thanh toán\nStripe" as U7
  usecase "Thanh toán\nVNPay" as U8
  usecase "Thanh toán khi\nnhận hàng (COD)" as U9
  usecase "Xác nhận thanh toán\nqua webhook" as U10
  usecase "Gửi email\nxác nhận đơn" as U11
}

G --> U1
M --> U1
U1 ..> U2 : <<include>>
U1 ..> U3 : <<include>>
U3 <-- SHIP
G --> U4
M --> U4
G --> U5
M --> U5
U5 <|-- U7
U5 <|-- U8
U5 <|-- U9
U5 ..> U6 : <<include>>
U6 ..> U10 : <<include>>
U10 <-- PAY
U10 ..> U11 : <<include>>
@enduml
