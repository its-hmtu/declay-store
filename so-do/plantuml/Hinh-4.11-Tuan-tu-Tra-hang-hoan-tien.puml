@startuml
skinparam dpi 160
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #7A5C43
skinparam ArrowFontSize 12
skinparam actorStyle awesome
skinparam actor {
  BorderColor #7A5C43
  BackgroundColor #F3E7D8
}
skinparam usecase {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
  FontSize 13
}
skinparam rectangle {
  BorderColor #A98867
  BackgroundColor #FFFDF9
}
skinparam component {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
}
skinparam database {
  BorderColor #7A5C43
  BackgroundColor #F3E7D8
}
skinparam queue {
  BorderColor #7A5C43
  BackgroundColor #F3E7D8
}
skinparam cloud {
  BorderColor #A98867
  BackgroundColor #FFFDF9
}
skinparam participant {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
}
skinparam sequence {
  LifeLineBorderColor #A98867
  LifeLineBackgroundColor #F3E7D8
  ArrowColor #7A5C43
  DividerBackgroundColor #EFE2D0
  BoxBackgroundColor #FAF5EE
  BoxBorderColor #C9B197
  GroupBackgroundColor #EFE2D0
  GroupBorderColor #A98867
}
skinparam note {
  BorderColor #C9A227
  BackgroundColor #FFF9E8
}
skinparam class {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
  HeaderBackgroundColor #E8D7C3
}
autonumber

title Biểu đồ tuần tự chức năng Trả hàng và hoàn tiền

actor "Khách hàng" as U
participant "Giao diện" as FE
participant "UploadController" as UP
participant "ReturnService" as RS
database "PostgreSQL" as DB
actor "Quản trị viên" as A
participant "RefundService" as RF
participant "OrderService" as OS

U -> FE : Chọn món, số lượng, tải ảnh chứng minh
FE -> UP : POST /api/returns (ảnh)
UP --> FE : Danh sách photoUrls
FE -> RS : POST /api/orders/:id/returns
RS -> DB : SELECT orders (status, delivered_at)
RS -> RS : returnRejectionReason(status, deliveredAt)
alt Quá hạn 7 ngày hoặc trạng thái sai
  RS --> FE : AppError 400 + ngày hết hạn
else Hợp lệ
  RS -> RS : validateReturnLines(lines, purchased)
  alt Thiếu ảnh hoặc vượt số lượng
    RS --> FE : AppError 400
  else Dữ liệu hợp lệ
    RS -> DB : INSERT return_requests (pending)
    RS -> DB : INSERT return_request_items
    RS --> FE : Yêu cầu đã được ghi nhận
    A -> RS : POST /api/admin/orders/returns/:id/approve
    U -> RS : Cung cấp mã vận đơn trả hàng
    A -> RS : POST /api/admin/orders/returns/:id/receive
    RS -> RS : returnItemsSubtotal + phí ship nếu trả toàn bộ
    RS -> RF : Khởi tạo hoàn tiền
    RF -> DB : INSERT refunds
    RS -> OS : Cập nhật partialReturned hoặc status='returned'
    OS -> DB : UPDATE orders
  end
end
@enduml
