autonumber

title Biểu đồ tuần tự chức năng Thêm sản phẩm vào giỏ hàng

actor "Người dùng" as U
participant "Giao diện" as FE
participant "CartController" as C
participant "CartService" as S
database "PostgreSQL" as DB

U -> FE : Chọn phiên bản, nhấn "Thêm vào giỏ"
FE -> C : POST /api/cart/items {variantId, quantity}
C -> S : addItem(owner, variantId, quantity)
S -> S : Xác định chủ giỏ (userId hoặc sessionId)
S -> DB : SELECT carts WHERE user_id / session_id
alt Chưa có giỏ hàng
  S -> DB : INSERT carts
end
S -> DB : SELECT product_variants WHERE id = ?
DB --> S : Phiên bản (stock, isActive)
alt Hết hàng hoặc vượt tồn kho
  S --> C : AppError 400
  C --> FE : Thông báo số lượng tối đa
else Còn đủ hàng
  alt Dòng đã tồn tại
    S -> DB : UPDATE cart_items SET quantity += ?
  else Dòng mới
    S -> DB : INSERT cart_items
  end
  S -> DB : SELECT lại giỏ hàng đầy đủ
  S -> S : Tính giá hiệu lực từng dòng
  S --> C : Giỏ hàng đã cập nhật
  C --> FE : sendSuccess(200)
  FE --> U : Mở ngăn kéo giỏ hàng
end
@enduml
