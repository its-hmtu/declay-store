@startuml
skinparam dpi 160
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #7A5C43
skinparam ArrowFontSize 12
skinparam actorStyle awesome
skinparam actor {
  BorderColor #7A5C43
  BackgroundColor #F3E7D8
}
skinparam usecase {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
  FontSize 13
}
skinparam rectangle {
  BorderColor #A98867
  BackgroundColor #FFFDF9
}
skinparam component {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
}
skinparam database {
  BorderColor #7A5C43
  BackgroundColor #F3E7D8
}
skinparam queue {
  BorderColor #7A5C43
  BackgroundColor #F3E7D8
}
skinparam cloud {
  BorderColor #A98867
  BackgroundColor #FFFDF9
}
skinparam participant {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
}
skinparam sequence {
  LifeLineBorderColor #A98867
  LifeLineBackgroundColor #F3E7D8
  ArrowColor #7A5C43
  DividerBackgroundColor #EFE2D0
  BoxBackgroundColor #FAF5EE
  BoxBorderColor #C9B197
  GroupBackgroundColor #EFE2D0
  GroupBorderColor #A98867
}
skinparam note {
  BorderColor #C9A227
  BackgroundColor #FFF9E8
}
skinparam class {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
  HeaderBackgroundColor #E8D7C3
}
title Kiến trúc tổng thể hệ thống Declay Store

rectangle "TẦNG TRÌNH DIỄN" as L1 #FFFDF9 {
  component "Storefront\n(storefront)\nNext.js 16 · React 19 · Tailwind v4" as SF
  component "Admin Dashboard\nadmin/(protected)\nNext.js 16" as AD
}

rectangle "TẦNG NGHIỆP VỤ — Web API (Express 4 + TypeScript)" as L2 #FFFDF9 {
  component "Nhánh khách hàng\n/api/*" as R1
  component "Nhánh quản trị\n/api/admin/*" as R2
  component "40+ module nghiệp vụ\nentity · interface · validate\nservice · controller · route" as MOD
}

rectangle "TẦNG DỮ LIỆU & HẠ TẦNG" as L3 #FFFDF9 {
  database "PostgreSQL 15\n~38 bảng" as PG
  database "Redis 7\ncache · denylist" as RD
  queue "BullMQ\nreservation · email\nghn-sync · recommendation\nreturn-expiry" as MQ
}

cloud "Stripe" as ST
cloud "VNPay" as VN
cloud "GHN" as GHN
cloud "Google OAuth" as GG
cloud "SMTP" as MAIL
cloud "Claude API" as AI

SF --> R1 : REST + SSE
AD --> R2 : REST + SSE
R1 --> MOD
R2 --> MOD
MOD --> PG
MOD --> RD
MOD --> MQ
MOD --> ST
MOD --> VN
MOD --> GHN
MOD --> GG
MOD --> MAIL
MOD --> AI
@enduml
