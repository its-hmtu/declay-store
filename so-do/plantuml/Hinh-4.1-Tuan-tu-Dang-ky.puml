@startuml
skinparam dpi 160
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #7A5C43
skinparam ArrowFontSize 12
skinparam actorStyle awesome
skinparam actor {
  BorderColor #7A5C43
  BackgroundColor #F3E7D8
}
skinparam usecase {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
  FontSize 13
}
skinparam rectangle {
  BorderColor #A98867
  BackgroundColor #FFFDF9
}
skinparam component {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
}
skinparam database {
  BorderColor #7A5C43
  BackgroundColor #F3E7D8
}
skinparam queue {
  BorderColor #7A5C43
  BackgroundColor #F3E7D8
}
skinparam cloud {
  BorderColor #A98867
  BackgroundColor #FFFDF9
}
skinparam participant {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
}
skinparam sequence {
  LifeLineBorderColor #A98867
  LifeLineBackgroundColor #F3E7D8
  ArrowColor #7A5C43
  DividerBackgroundColor #EFE2D0
  BoxBackgroundColor #FAF5EE
  BoxBorderColor #C9B197
  GroupBackgroundColor #EFE2D0
  GroupBorderColor #A98867
}
skinparam note {
  BorderColor #C9A227
  BackgroundColor #FFF9E8
}
skinparam class {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
  HeaderBackgroundColor #E8D7C3
}
autonumber

title Biểu đồ tuần tự chức năng Đăng ký tài khoản

actor "Người dùng" as U
participant "Giao diện\n(Next.js)" as FE
participant "validate\n(Zod)" as VAL
participant "AuthController" as C
participant "AuthService" as S
database "PostgreSQL" as DB
queue "emailQueue" as Q

U -> FE : Nhập email, mật khẩu, họ tên
FE -> VAL : POST /api/auth/register
VAL -> VAL : Kiểm tra lược đồ dữ liệu
alt Dữ liệu không hợp lệ
  VAL --> FE : 400 + lỗi từng trường
else Hợp lệ
  VAL -> C : next()
  C -> S : register(data)
  S -> DB : Tìm user theo email
  DB --> S : Không tồn tại
  S -> S : Băm mật khẩu
  S -> DB : INSERT users
  S -> DB : INSERT email_verification_tokens
  S -> Q : Đẩy job gửi email xác thực
  S --> C : Kết quả
  C --> FE : sendSuccess(201)
  FE --> U : Thông báo kiểm tra hộp thư
end
@enduml
