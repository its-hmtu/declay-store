@startuml
skinparam dpi 160
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #7A5C43
skinparam ArrowFontSize 12
skinparam actorStyle awesome
skinparam actor {
  BorderColor #7A5C43
  BackgroundColor #F3E7D8
}
skinparam usecase {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
  FontSize 13
}
skinparam rectangle {
  BorderColor #A98867
  BackgroundColor #FFFDF9
}
skinparam component {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
}
skinparam database {
  BorderColor #7A5C43
  BackgroundColor #F3E7D8
}
skinparam queue {
  BorderColor #7A5C43
  BackgroundColor #F3E7D8
}
skinparam cloud {
  BorderColor #A98867
  BackgroundColor #FFFDF9
}
skinparam participant {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
}
skinparam sequence {
  LifeLineBorderColor #A98867
  LifeLineBackgroundColor #F3E7D8
  ArrowColor #7A5C43
  DividerBackgroundColor #EFE2D0
  BoxBackgroundColor #FAF5EE
  BoxBorderColor #C9B197
  GroupBackgroundColor #EFE2D0
  GroupBorderColor #A98867
}
skinparam note {
  BorderColor #C9A227
  BackgroundColor #FFF9E8
}
skinparam class {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
  HeaderBackgroundColor #E8D7C3
}
autonumber

title Biểu đồ tuần tự chức năng Xóa sản phẩm

actor "Quản trị viên" as A
participant "Giao diện Admin" as FE
participant "ProductService" as S
database "PostgreSQL" as DB
participant "auditAdminWrites" as AU
database "Redis" as RD

A -> FE : Chọn Xóa và xác nhận trong hộp thoại
FE -> S : DELETE /api/admin/products/:id
S -> DB : SELECT products WHERE id = ?
alt Không tồn tại
  S --> FE : AppError 404
else Tồn tại
  S -> DB : DELETE product_variants (CASCADE)
  S -> DB : DELETE products
  note right of DB
    order_items giữ nguyên nhờ bản chụp
    product_name_at_purchase và price_at_purchase
  end note
  S -> RD : Xóa cache liên quan
  S --> AU : Kết quả
  AU -> DB : INSERT audit_log (action = delete)
  AU --> FE : sendSuccess(200)
  FE --> A : Cập nhật lại danh sách sản phẩm
end
@enduml
