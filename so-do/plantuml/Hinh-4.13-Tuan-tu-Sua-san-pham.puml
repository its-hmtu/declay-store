autonumber

title Biểu đồ tuần tự chức năng Chỉnh sửa sản phẩm

actor "Quản trị viên" as A
participant "Giao diện Admin" as FE
participant "validate" as VAL
participant "ProductService" as S
database "PostgreSQL" as DB
database "Redis" as RD

A -> FE : Chọn sản phẩm và thay đổi thông tin
FE -> VAL : PUT /api/admin/products/:id
VAL -> VAL : Kiểm tra params + body (ít nhất 1 trường)
alt Không có trường nào thay đổi
  VAL --> FE : 400 Bad Request
else Hợp lệ
  VAL -> S : update(id, data)
  S -> DB : SELECT products WHERE id = ?
  alt Không tồn tại
    S --> FE : AppError 404
  else Tồn tại
    S -> DB : UPDATE products
    S -> DB : Đồng bộ lại product_tags
    S -> RD : Xóa cache danh sách và chi tiết
    S --> FE : sendSuccess(200)
    FE --> A : Thông báo cập nhật thành công
  end
end
@enduml
