  BackgroundColor #FFF9E8
}
skinparam class {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
  HeaderBackgroundColor #E8D7C3
}
autonumber

title Biểu đồ tuần tự chức năng Đặt hàng và thanh toán

actor "Khách hàng" as U
participant "Giao diện" as FE
participant "OrderService" as OS
participant "CampaignService" as CS
participant "DiscountService" as DS
participant "GhnService" as GS
database "PostgreSQL" as DB
queue "reservationQueue" as RQ
participant "Stripe / VNPay" as PAY

U -> FE : Chọn địa chỉ, mã giảm giá, phương thức thanh toán
FE -> OS : POST /api/orders/checkout
OS -> DB : SELECT giỏ hàng + phiên bản
OS -> CS : getWinningCampaigns(productIds)
CS --> OS : Chiến dịch thắng theo sản phẩm
OS -> OS : Tính đơn giá hiệu lực và subtotal
OS -> DS : validateCode(code, subtotal)
DS --> OS : discountAmount
OS -> GS : quote(district, ward, weight)
GS --> OS : shippingFee
OS -> OS : totalAmount = subtotal - discount + shippingFee

group Giao dịch cơ sở dữ liệu
  OS -> DB : INSERT orders (status = pending_payment)
  OS -> DB : INSERT order_items (bản chụp tên, giá)
  OS -> DB : UPDATE product_variants SET stock = stock - qty
end

OS -> RQ : Lên lịch hủy đơn nếu quá hạn giữ chỗ
alt Stripe
  OS -> PAY : Tạo PaymentIntent
  PAY --> OS : clientSecret
  OS --> FE : clientSecret
  FE --> U : Nhập thông tin thẻ (Stripe Elements)
else VNPay
  OS -> OS : Dựng URL thanh toán ký HMAC
  OS --> FE : paymentUrl
  FE --> U : Chuyển hướng sang cổng VNPay
else COD
  OS --> FE : Đơn đã tạo
  FE --> U : Trang xác nhận đặt hàng
end
@enduml
