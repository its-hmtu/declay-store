  BackgroundColor #FFF9E8
}
skinparam class {
  BorderColor #7A5C43
  BackgroundColor #FBF3E7
  HeaderBackgroundColor #E8D7C3
}
autonumber

title Biểu đồ tuần tự chức năng Đăng nhập

actor "Người dùng" as U
participant "Giao diện" as FE
participant "authLimiter" as RL
participant "AuthController" as C
participant "AuthService" as S
database "PostgreSQL" as DB

U -> FE : Nhập email và mật khẩu
FE -> RL : POST /api/auth/login
RL -> RL : Kiểm tra tần suất (20 lần / 15 phút)
alt Vượt ngưỡng
  RL --> FE : 429 Too Many Requests
else Trong ngưỡng
  RL -> C : next()
  C -> S : login(email, password)
  S -> DB : SELECT * FROM users WHERE email = ?
  DB --> S : Bản ghi người dùng
  S -> S : So khớp mật khẩu đã băm
  alt Sai thông tin
    S --> C : AppError 401
    C --> FE : "Email hoặc mật khẩu không đúng"
  else Đúng thông tin
    S -> S : Sinh access token + refresh token
    S --> C : Tokens + hồ sơ
    C --> FE : sendSuccess(200)
    FE -> FE : Lưu token, cập nhật trạng thái
    FE --> U : Chuyển về trang trước đó
  end
end
@enduml
