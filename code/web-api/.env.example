# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database (PostgreSQL — non-default port 5431) ────────────
DB_HOST=localhost
DB_PORT=5431
DB_USER=declay_admin
DB_PASSWORD=your_db_password
DB_NAME=declay_store

# ── Redis (non-default port 6378) ────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6378
# REDIS_PASSWORD=your_redis_password   # optional, only if Redis requires auth
REDIS_DB=0

# ── JWT (customer) ───────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRED_IN=15m
JWT_REFRESH_EXPIRED_IN=7d

# ── JWT (admin — separate table, separate secret) ────────────
JWT_ADMIN_SECRET=change_me_admin_secret
JWT_ADMIN_EXPIRED_IN=8h
# M-25: refresh token cho admin. De trong thi tu suy ra tu JWT_ADMIN_SECRET.
JWT_ADMIN_REFRESH_SECRET=change_me_admin_refresh_secret
JWT_ADMIN_REFRESH_EXPIRED_IN=30d

# ── Password hashing ─────────────────────────────────────────
AUTH_SALT_ROUNDS=10

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
FRONTEND_URL=http://localhost:3000

# ── Session ──────────────────────────────────────────────────
SESSION_SECRET=change_me_session_secret

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# VNPay (M-12) — sandbox
VNPAY_TMN_CODE=JYEVZ7T4
VNPAY_HASH_SECRET=VOZOGJFQGTPOIOLHMRBAYCLBKLVYMJFP
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/checkout/vnpay-return
# BAT BUOC: VNPay chi nhan VND, shop niem yet USD.
# Thieu hoac dat = 1 -> don hang VNPay bi chan (503) thay vi thu sai tien.
VNPAY_USD_TO_VND=26000
VNPAY_EXPIRE_MINUTES=15

# GHN (M-13) - van chuyen noi dia
# De trong TOKEN/SHOP_ID -> he thong dung provider gia lap (chi dung cho dev).
GHN_TOKEN=
GHN_SHOP_ID=
# Moi truong dev cua GHN (dev-online-gateway) da NGUNG PHAN HOI -> dung production.
# An toan KHONG dua vao URL ma dua vao quyen thao tac (xem ghn.mode.ts):
#   - Tra cuu dia gioi + tinh phi = CHI DOC, khong tao ra gi, khong phat sinh cuoc.
#   - Tao/huy van don = ghi that -> phai bat GHN_ALLOW_WRITE=true moi chay duoc.
GHN_BASE_URL=https://online-gateway.ghn.vn

# CHE DO CHAY (moi truong test):
#   mock     - khong goi GHN, dung du lieu gia lap
#   preview  - GOI API PREVIEW THAT cua GHN: kiem chung dia chi, dich vu, phi,
#              ngay giao du kien... nhung KHONG tao van don, KHONG mat cuoc.
#              -> Day la che do nen dung khi test.
#   readonly - chi tra dia gioi + tinh phi (mac dinh khi co token)
#   live     - tao van don THAT, phai kem GHN_ALLOW_WRITE=true
GHN_MODE=preview

# Chi bat khi thuc su muon tao van don THAT (phat sinh cuoc).
GHN_ALLOW_WRITE=false
# Kho lay hang. De trong thi GHN dung dia chi mac dinh cua ShopId.
GHN_FROM_DISTRICT_ID=
GHN_FROM_WARD_CODE=
# 2 = Hang nhe (E-Commerce Delivery), 5 = Hang nang
GHN_SERVICE_TYPE_ID=2

# Chinh sach phi ship cua cua hang (VND)
SHIPPING_FREE_OVER_VND=500000
SHIPPING_SUBSIDY_VND=0

# M-15: ti gia dung MOT LAN khi chay migration 021 de doi du lieu cu tu USD sang VND
VND_MIGRATION_RATE=26000
# Local webhook testing: stripe listen --forward-to localhost:3000/api/webhooks/stripe

# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Declay Store <noreply@declay.store>

# ── AI (Anthropic Claude) ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Models. Defaults are Haiku (cheap, for testing). For production use:
#   ANTHROPIC_STOREFRONT_MODEL=claude-sonnet-4-6
#   ANTHROPIC_ADMIN_MODEL=claude-opus-4-8
ANTHROPIC_STOREFRONT_MODEL=claude-haiku-4-5
ANTHROPIC_ADMIN_MODEL=claude-haiku-4-5

# W-18 Object storage (Cloudinary). If unset, uploads fall back to local disk.
# Either set CLOUDINARY_URL, or the three vars below.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
