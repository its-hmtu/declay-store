# ── Database ────────────────────────────────────────────────
DB_USER=declay_admin
DB_PASSWORD=change-me-strong
DB_NAME=declay_store

# ── Public URLs (must be HTTPS for VNPay callbacks) ─────────
API_PUBLIC_URL=https://api.staging.your-domain.com
NEXT_PUBLIC_API_URL=https://api.staging.your-domain.com/api
NEXT_PUBLIC_SITE_URL=https://staging.your-domain.com

# ── Auth secrets (generate: openssl rand -base64 48) ────────
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Media ───────────────────────────────────────────────────
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ── Payments (MVP = COD only; VNPay added later) ────────────
PAYMENTS_DOMESTIC=cod
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Optional ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
